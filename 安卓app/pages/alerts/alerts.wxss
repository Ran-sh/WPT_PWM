/* ═══════════════════════════════════════════
   WPT Monitor — 报警页
   Social-app polished design
   ═══════════════════════════════════════════ */

.page { padding:0 24rpx calc(100rpx + env(safe-area-inset-bottom, 0px)); min-height:100vh; }
/* background 由 app.wxss .page 统一提供 */

.header-bar { display:flex; justify-content:space-between; align-items:center; padding:32rpx 4rpx 36rpx; }
.header-title { font-size:40rpx; font-weight:900; color:var(--text-primary); letter-spacing:3rpx; text-shadow:0 0 28rpx rgba(0,229,255,0.12); }

.btn { padding:10rpx 22rpx; border-radius:12rpx; font-size:22rpx; font-weight:700; box-shadow: var(--bezel); transition: transform 0.12s cubic-bezier(0.34, 1.56, 0.64, 1); }
.btn:active { transform: scale(0.95); }
.btn-blue { background:var(--accent-bg); color:var(--accent); border:1rpx solid var(--accent-border); }
.btn-red  { background:var(--red-bg); color:var(--red); border:1rpx solid rgba(239,68,68,0.1); }

/* Filter tabs */
.filter-tabs { display:flex; gap:4rpx; background:var(--tab-bar-bg); border-radius:14rpx; padding:4rpx; margin-bottom:18rpx; border:1rpx solid var(--card-border); }
.filter-tab { flex:1; text-align:center; padding:10rpx 0; border-radius:12rpx; font-size:24rpx; color:var(--text-tertiary); font-weight:700; transition: all 0.15s ease; }
.filter-tab.active { background:var(--card-bg); color:var(--accent); box-shadow:0 2rpx 10rpx rgba(0,0,0,0.2), var(--bezel); }

/* Empty state */
.empty { text-align:center; padding:120rpx 0; }
.empty-icon { font-size:72rpx; display:block; margin-bottom:18rpx; opacity:0.15; }
.empty-text { font-size:26rpx; color:var(--text-tertiary); }

/* Alert cards */
.alert-card { background:var(--card-bg); border:1rpx solid var(--card-border); border-radius:28rpx; padding:24rpx 30rpx; margin-bottom:16rpx; box-shadow:var(--bezel-strong); position:relative; overflow:hidden; transition: opacity 0.2s; }
.alert-card:after { content:''; position:absolute; top:0; left:0; right:0; height:1rpx; background:linear-gradient(90deg,transparent,rgba(0,229,255,0.08),transparent); opacity:0.5; }
.alert-card.read { opacity:0.5; }
.alert-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:10rpx; }
.alert-status { display:flex; align-items:center; gap:6rpx; font-size:20rpx; font-weight:700; padding:4rpx 10rpx; border-radius:8rpx; }
.alert-status.critical { background:var(--red-bg);  color:var(--red);  border:1rpx solid rgba(239,68,68,0.1); }
.alert-status.warn     { background:var(--accent-bg); color:var(--accent); border:1rpx solid var(--accent-border); }
.alert-status.done     { background:var(--toggle-bg); color:var(--text-tertiary); }
.status-dot { width:8rpx; height:8rpx; border-radius:50%; }
.alert-status.critical .status-dot { background:var(--red);    box-shadow: 0 0 6rpx rgba(239,68,68,0.5); }
.alert-status.warn     .status-dot { background:var(--accent); box-shadow: 0 0 6rpx rgba(0,229,255,0.4); }
.alert-status.done     .status-dot { background:var(--text-tertiary); }
.alert-time { font-size:20rpx; color:var(--text-tertiary); font-family:monospace; }
.alert-title { font-size:28rpx; font-weight:800; color:var(--text-primary); display:block; margin-bottom:10rpx; }
.alert-values { display:flex; align-items:baseline; gap:18rpx; }
.alert-val { font-size:28rpx; font-weight:800; }
.alert-val.val-bad  { color:var(--red); }
.alert-val.val-warn { color:var(--accent); }
.alert-threshold { font-size:20rpx; color:var(--text-tertiary); }

/* Alert actions */
.alert-actions { margin-top:16rpx; display:flex; }
.alert-actions view { transition: transform 0.12s cubic-bezier(0.34, 1.56, 0.64, 1); }
.alert-actions view:active { transform: scale(0.95); }
/* WPT Monitor V5.1.3：报警记录页样式。 */
