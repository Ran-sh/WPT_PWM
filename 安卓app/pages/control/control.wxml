<view class="page {{currentTheme}}">
  <view class="header-bar"><text class="header-title">设备控制</text>
    <view class="state-badge {{systemState}}"><text>{{stateLabel}}</text><view bindtap="onToggleTheme" style="font-size:30rpx;margin-left:16rpx;width:52rpx;height:52rpx;border-radius:50%;background:var(--toggle-bg);display:flex;align-items:center;justify-content:center;">{{currentTheme === 'theme-dark' ? '🌙' : '☀'}}</view></view>
  </view>
  <view class="card ctrl-card"><view class="ctrl-left"><view class="ctrl-icon power"><text>⏻</text></view><view><text class="ctrl-name">启停控制</text><text class="ctrl-hint {{isOn ? 'on' : 'off'}}">{{isOn ? '运行中' : '已停止'}}</text></view></view><switch checked="{{isOn}}" bindchange="onSwitch" color="#22C55E"/></view>
  <view class="card ctrl-card"><view class="ctrl-left"><view class="ctrl-icon wifi"><text>📶</text></view><view><text class="ctrl-name">WiFi开关</text><text class="ctrl-hint {{wifiOn ? 'on' : 'off'}}">{{wifiOn ? '已连接' : '已断开'}}</text></view></view><switch checked="{{wifiOn}}" bindchange="onWifiSwitch" color="#3B82F6"/></view>
  <view class="card ctrl-card"><view class="ctrl-left"><view class="ctrl-icon freq"><text>〰</text></view><view><text class="ctrl-name">频率设置</text><text class="ctrl-hint">目标频率</text></view></view><view class="freq-row"><view class="freq-swiper-wrap"><swiper class="freq-swiper" current="{{freqIdx}}" bindchange="onSwiperChange"><swiper-item wx:for="{{freqList}}" wx:key="*this"><view class="swipe-num {{index === freqIdx ? 'sel' : ''}}">{{item}}</view></swiper-item></swiper></view></view><text class="freq-unit">kHz</text></view>
  <view class="btn-confirm {{isOn ? '' : 'disabled'}}" bindtap="onSetFreq"><text>确认设置</text></view>
  <view class="card log-card"><view class="log-header"><text class="log-title">操作记录</text><view class="btn-clear" bindtap="onClearLogs"><text>清空</text></view></view>
    <view wx:if="{{logs.length === 0}}" class="log-empty">暂无操作记录</view>
    <view class="log-row" wx:for="{{logs}}" wx:key="time"><text class="log-time">{{item.time}}</text><text class="log-action">{{item.status}}</text><text class="log-ok">成功</text></view>
  </view>
</view>
