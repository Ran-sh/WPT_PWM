/* ═══════════════════════════════════════════
   WPT Monitor — 监测页
   Social-app polished design
   ═══════════════════════════════════════════ */

.page { padding:0 24rpx calc(100rpx + env(safe-area-inset-bottom, 0px)); min-height:100vh; }
/* background 由 app.wxss .page 统一提供 */

/* ══ Header ══ */
.header-bar { display:flex; justify-content:space-between; align-items:center; padding:32rpx 4rpx 36rpx; }
.header-title { font-size:40rpx; font-weight:900; color:var(--text-primary); letter-spacing:3rpx; text-shadow:0 0 28rpx rgba(0,229,255,0.12); }
.header-badge { display:flex; align-items:center; gap:8rpx; padding:8rpx 18rpx; border-radius:16rpx; background:rgba(34,197,94,0.05); border:1rpx solid rgba(34,197,94,0.1); margin-top:8rpx; }
.badge-dot { width:12rpx; height:12rpx; border-radius:50%; }
.badge-dot.green { background: var(--green); box-shadow: 0 0 8rpx rgba(34,197,94,0.45); animation: pulse-dot 2s ease-in-out infinite; }
.badge-text { font-size:22rpx; color:var(--green); font-weight:700; }

/* ══ Sensor Cards ══ */
.card-list { display:flex; flex-direction:column; gap:20rpx; margin-bottom:28rpx; }
.sensor-card {
  background: var(--card-bg);
  border:1rpx solid var(--card-border);
  border-radius: 28rpx; padding: 30rpx 34rpx;
  box-shadow: var(--bezel-strong);
  position: relative; overflow: hidden;
  transition: border-color 0.25s ease;
}
.sensor-card:after { content:''; position:absolute; top:0; left:0; right:0; height:1rpx; background:linear-gradient(90deg,transparent,rgba(0,229,255,0.08),transparent); opacity:0.5; }
.sensor-card.alert {
  border-color: rgba(239,68,68,0.18);
  box-shadow: var(--bezel-strong), 0 0 24rpx rgba(239,68,68,0.05);
}
.sensor-top { display:flex; justify-content:space-between; align-items:center; }
.sensor-name { font-size:22rpx; font-weight:700; color:var(--text-tertiary); letter-spacing:4rpx; text-transform:uppercase; }
.sensor-icon-wrap {
  width:56rpx; height:56rpx; border-radius:16rpx; display:flex; align-items:center; justify-content:center;
  background: rgba(0,229,255,0.03); border: 1rpx solid rgba(0,229,255,0.06);
}
.sensor-icon { font-size:28rpx; }
.sensor-val-row { display:flex; align-items:baseline; margin-top:14rpx; }
.sensor-val {
  font-size: 62rpx; font-weight: 900; color: var(--accent);
  font-variant-numeric: tabular-nums; text-shadow: var(--accent-glow);
}
.sensor-unit { font-size:28rpx; color:var(--text-tertiary); margin-left:10rpx; font-weight:700; }
.sensor-status { display:flex; align-items:center; gap:8rpx; margin-top:16rpx; padding:10rpx 16rpx; border-radius:10rpx; font-size:22rpx; font-weight:700; }
.sensor-status.normal { background:var(--green-bg); color:var(--green); border:1rpx solid rgba(34,197,94,0.08); }
.sensor-status.alert  { background:var(--red-bg);  color:var(--red);   border:1rpx solid rgba(239,68,68,0.08); }
.status-dot { width:10rpx; height:10rpx; border-radius:50%; }
.sensor-status.normal .status-dot { background:var(--green); box-shadow: 0 0 6rpx rgba(34,197,94,0.45); }
.sensor-status.alert  .status-dot { background:var(--red);   box-shadow: 0 0 6rpx rgba(239,68,68,0.45); }

/* ══ Chart ══ */
.chart-card {
  background: var(--card-bg);
  border:1rpx solid var(--card-border);
  border-radius: 28rpx; padding: 30rpx 34rpx;
  box-shadow: var(--bezel-strong);
  position: relative; overflow: hidden;
}
.chart-card:after { content:''; position:absolute; top:0; left:0; right:0; height:1rpx; background:linear-gradient(90deg,transparent,rgba(0,229,255,0.08),transparent); opacity:0.5; }
.chart-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:22rpx; }
.chart-title { font-size:26rpx; font-weight:800; color:var(--text-primary); letter-spacing:2rpx; }
.chart-tabs { display:flex; gap:4rpx; background:var(--tab-bar-bg); border-radius:14rpx; padding:4rpx; border:1rpx solid var(--card-border); }
.chart-tab { padding:10rpx 22rpx; border-radius:12rpx; font-size:24rpx; color:var(--text-tertiary); font-weight:700; transition: all 0.15s; }
.chart-tab.active { background:var(--card-bg); color:var(--accent); box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.18), var(--bezel); }
.trend-canvas { width:100%; height:420rpx; }
/* WPT Monitor V5.1.3：实时监测页样式。 */
