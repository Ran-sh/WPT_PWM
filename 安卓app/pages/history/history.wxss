/* ═══════════════════════════════════════════
   WPT Monitor — 历史页
   Social-app polished design
   ═══════════════════════════════════════════ */

.page { padding:0 24rpx calc(100rpx + env(safe-area-inset-bottom, 0px)); min-height:100vh; }
/* background 由 app.wxss .page 统一提供 */

.header-bar { display:flex; justify-content:space-between; align-items:center; padding:32rpx 4rpx 36rpx; }
.header-title { font-size:40rpx; font-weight:900; color:var(--text-primary); letter-spacing:3rpx; text-shadow:0 0 28rpx rgba(0,229,255,0.12); }
.header-sub { font-size:22rpx; color:var(--text-tertiary); font-weight:700; display:block; margin-top:4rpx; }

/* Filter tabs */
.filter-tabs { display:flex; gap:4rpx; background:var(--tab-bar-bg); border-radius:14rpx; padding:4rpx; margin-bottom:22rpx; border:1rpx solid var(--card-border); }
.filter-tab { flex:1; text-align:center; padding:12rpx 0; border-radius:12rpx; font-size:24rpx; color:var(--text-tertiary); font-weight:700; transition: all 0.15s ease; }
.filter-tab.active { background:var(--card-bg); color:var(--accent); box-shadow:0 2rpx 10rpx rgba(0,0,0,0.2), var(--bezel); }

/* Chart */
.chart-card {
  background: var(--card-bg);
  border:1rpx solid var(--card-border);
  border-radius: 28rpx; padding: 30rpx 30rpx 24rpx;
  margin-bottom: 22rpx;
  box-shadow: var(--bezel-strong);
  position: relative; overflow: hidden;
}
.chart-card:after { content:''; position:absolute; top:0; left:0; right:0; height:1rpx; background:linear-gradient(90deg,transparent,rgba(0,229,255,0.08),transparent); opacity:0.5; }
.history-canvas { width:100%; height:340rpx; }

/* Table */
.table-card { background:var(--card-bg); border:1rpx solid var(--card-border); border-radius:28rpx; overflow:hidden; box-shadow:var(--bezel-strong); }
.table-header { display:flex; padding:18rpx 28rpx; background:var(--tab-bar-bg); border-bottom:1rpx solid var(--card-border); }
.th { font-size:20rpx; color:var(--text-tertiary); font-weight:700; letter-spacing:2rpx; }
.th-time { flex:1.5; }
.th-val { flex:1; text-align:center; }
.th-status { width:60rpx; text-align:center; }
.table-row { display:flex; padding:18rpx 28rpx; border-bottom:1rpx solid var(--chart-grid); align-items:center; transition: background 0.12s; }
.table-row:active { background: rgba(255,255,255,0.02); }
.td-time { flex:1.5; display:flex; flex-direction:column; }
.td-time .time-date { font-size:17rpx; color:var(--text-tertiary); font-family:monospace; }
.td-time .time-hm { font-size:20rpx; color:var(--text-secondary); font-family:monospace; }
.td-val { flex:1; text-align:center; font-weight:700; font-size:24rpx; color:var(--text-primary); }
.td-val.val-bad { color:var(--red); }
.td-status { width:60rpx; display:flex; justify-content:center; align-items:center; }
.status-circle {
  width:40rpx; height:40rpx; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:20rpx; font-weight:800;
}
.status-circle.pass { background:var(--green-bg); color:var(--green); }
.status-circle.bad  { background:var(--red-bg);  color:var(--red); }
.empty { padding:60rpx; text-align:center; font-size:24rpx; color:var(--text-tertiary); }
/* WPT Monitor V5.1.3：历史数据页样式。 */
