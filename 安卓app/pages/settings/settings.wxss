/* ═══════════════════════════════════════════
   WPT Monitor — 设置页
   Social-app polished design
   ═══════════════════════════════════════════ */

.page { padding:0 24rpx calc(100rpx + env(safe-area-inset-bottom, 0px)); min-height:100vh; }
/* background 由 app.wxss .page 统一提供 */

.header-bar { display:flex; justify-content:space-between; align-items:center; padding:32rpx 4rpx 36rpx; }
.header-title { font-size:40rpx; font-weight:900; color:var(--text-primary); letter-spacing:3rpx; text-shadow:0 0 28rpx rgba(0,229,255,0.12); }

.section { margin-bottom:28rpx; }
.section-title { font-size:20rpx; font-weight:700; color:var(--text-tertiary); letter-spacing:4rpx; text-transform:uppercase; margin-bottom:14rpx; padding-left:4rpx; display:block; }

.card { background:var(--card-bg); border:1rpx solid var(--card-border); border-radius:28rpx; overflow:hidden; box-shadow:var(--bezel-strong); position:relative; }
.card:after { content:''; position:absolute; top:0; left:0; right:0; height:1rpx; background:linear-gradient(90deg,transparent,rgba(0,229,255,0.06),transparent); opacity:0.5; }
.card.row-card { padding:26rpx 30rpx; display:flex; justify-content:space-between; align-items:center; }

.form-item { padding:22rpx 28rpx; border-bottom:1rpx solid var(--chart-grid); }
.form-item.row { display:flex; align-items:center; gap:14rpx; border:none; }
.form-item:last-of-type { border:none; }
.label { font-size:25rpx; font-weight:600; color:var(--text-primary); display:block; margin-bottom:8rpx; }
.hint { font-size:20rpx; color:var(--text-tertiary); margin-top:4rpx; display:block; }
.input { width:100%; padding:14rpx 18rpx; background:var(--input-bg); border:1rpx solid var(--input-border); border-radius:14rpx; font-size:24rpx; color:var(--text-primary); }
.input.mono { font-family:monospace; font-size:22rpx; }
.input.flex-1 { flex:1; }
.form-footer { padding:22rpx 28rpx; display:flex; justify-content:space-between; align-items:center; }
.status-ok { font-size:20rpx; color:var(--green); font-weight:700; }
.status-no { font-size:20rpx; color:var(--text-tertiary); }
.btn-save { padding:12rpx 34rpx; background:var(--btn-bg); border:1rpx solid var(--btn-border); border-radius:14rpx; box-shadow:var(--btn-shadow); transition: transform 0.12s cubic-bezier(0.34, 1.56, 0.64, 1); }
.btn-save:active { transform: scale(0.95); }
.btn-save text { font-size:24rpx; font-weight:800; color:var(--btn-text); }
.arrow { font-size:32rpx; color:var(--text-tertiary); }

.about-card { padding:28rpx 30rpx; text-align:center; }
.about-title { font-size:28rpx; font-weight:900; color:var(--text-primary); display:block; margin-bottom:20rpx; letter-spacing:1rpx; }
.about-row { display:flex; justify-content:space-between; padding:16rpx 28rpx; background:var(--toggle-bg); border-radius:14rpx; margin-bottom:10rpx; }
.about-key { font-size:24rpx; color:var(--text-tertiary); }
.about-val { font-size:24rpx; color:var(--text-primary); font-weight:700; }
.disclaimer { padding:18rpx; background:rgba(245,158,11,0.04); border:1rpx solid rgba(245,158,11,0.08); border-radius:14rpx; margin-top:14rpx; }
.disclaimer text { font-size:20rpx; color:var(--yellow-dim); line-height:1.6; }
/* WPT Monitor V5.1.3：设置页样式。 */
