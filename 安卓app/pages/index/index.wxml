<!-- WPT Monitor — 首页仪表盘 (对齐 Web index.html) -->
<view class="page {{currentTheme}}">
  <!-- Header -->
  <view class="header">
    <view class="header-left">
      <text class="header-title">{{dashTitle}}</text>
      <view class="toggle-theme" bindtap="onToggleTheme"><text>{{currentTheme === 'theme-dark' ? '🌙' : '☀'}}</text></view>
    </view>
    <view class="conn-badge {{connState === 0 ? 'conn-on' : (connState === 1 ? 'conn-off' : (connState === 2 ? 'conn-err' : 'conn-init'))}}" bindtap="onConnTap">
      <view class="conn-dot"></view>
      <text>{{connLabel}}</text>
    </view>
  </view>

  <!-- 告警横幅 -->
  <view wx:if="{{alertVisible}}" class="alert-banner" bindtap="onAlertTap">
    <text wx:for="{{alertMessages}}" wx:key="*this" wx:for-item="msg">⚠ {{msg}}  </text>
  </view>

  <!-- 传感器卡片 (动态渲染, 对齐 Web renderDashboard) -->
  <view class="card-list">
    <view class="sensor-card" wx:for="{{sensors}}" wx:key="id">
      <text class="card-label">{{item.name}}</text>
      <view class="sensor-value-row">
        <text class="sensor-value">{{item.value}}</text>
        <text class="sensor-unit">{{item.unit}}</text>
      </view>
      <view class="sensor-status {{item.status}}">
        <view class="status-dot"></view>
        <text>{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <!-- 控制卡片 -->
  <view class="card-list">
    <view class="ctrl-card" wx:for="{{controls}}" wx:key="id">
      <text class="card-label">{{item.name}}</text>
      <text class="ctrl-value">{{item.value}}</text>
    </view>
  </view>
</view>
