/* ═══════════════════════════════════════════
   WPT Monitor — Home Dashboard
   对齐 Web index.html 布局
   ═══════════════════════════════════════════ */

.page {
  min-height: 100vh;
  padding: 0 24rpx calc(100rpx + env(safe-area-inset-bottom, 0px));
}

/* ══ Header ══ */
.header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx 4rpx 36rpx;
}
.header-left { display: flex; align-items: center; gap: 14rpx; }
.header-title {
  font-size: 40rpx; font-weight: 900; color: var(--text-primary);
  letter-spacing: 3rpx;
  text-shadow: 0 0 28rpx rgba(0,229,255,0.12);
}

.toggle-theme {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--toggle-bg); border: 1rpx solid rgba(255,255,255,0.05);
  font-size: 24rpx; color: var(--text-secondary);
  box-shadow: var(--bezel);
  vertical-align: middle;
}
.toggle-theme:active { transform: scale(0.92); }

/* ══ Connection Badge ══ */
.conn-badge {
  display: flex; align-items: center; gap: 10rpx;
  padding: 12rpx 24rpx; border-radius: 24rpx;
  font-size: 23rpx; font-weight: 700; letter-spacing: 0.5rpx;
}
.conn-on  { background: var(--conn-on-bg);  color: var(--accent); border: 1rpx solid var(--conn-on-border);  box-shadow: var(--bezel), 0 0 16rpx rgba(0,229,255,0.06); }
.conn-off { background: var(--conn-off-bg); color: var(--yellow); border: 1rpx solid var(--conn-off-border); box-shadow: var(--bezel); }
.conn-err { background: var(--conn-err-bg); color: var(--red);    border: 1rpx solid var(--conn-err-border); box-shadow: var(--bezel); }
.conn-init{ background: rgba(255,255,255,0.015); color: var(--text-tertiary); border: 1rpx solid rgba(255,255,255,0.03); box-shadow: var(--bezel); }
.conn-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.conn-on  .conn-dot { background: var(--accent); box-shadow: var(--accent-glow); animation: pulse-dot 2s ease-in-out infinite; }
.conn-off .conn-dot { background: var(--yellow); box-shadow: var(--yellow-glow); }
.conn-err .conn-dot { background: var(--red);    box-shadow: var(--red-glow); }
.conn-init.conn-dot { background: var(--text-tertiary); }

/* ══ 告警横幅 ══ */
.alert-banner {
  margin-bottom: 20rpx; padding: 16rpx 24rpx;
  background: rgba(239,68,68,0.04); border: 1rpx solid rgba(239,68,68,0.1);
  border-radius: 14rpx; font-size: 24rpx; color: var(--red);
  text-align: center; font-weight: 600;
}

/* ══ 传感器卡片列表 ══ */
.card-list { display: flex; flex-direction: column; gap: 18rpx; margin-bottom: 28rpx; }
.sensor-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx; padding: 30rpx 34rpx;
  box-shadow: var(--bezel-strong);
  position: relative; overflow: hidden;
}
.sensor-card:after {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(0,229,255,0.08), transparent);
  opacity: 0.5;
}
.card-label {
  font-size: 22rpx; font-weight: 700; color: var(--text-tertiary);
  letter-spacing: 4rpx; text-transform: uppercase;
  margin-bottom: 14rpx; display: block;
}
.sensor-value-row { display: flex; align-items: baseline; gap: 8rpx; }
.sensor-value {
  font-size: 64rpx; font-weight: 900; color: var(--accent);
  font-variant-numeric: tabular-nums;
  text-shadow: var(--accent-glow);
}
.sensor-unit { font-size: 28rpx; color: var(--text-tertiary); font-weight: 700; }

/* 传感器状态 */
.sensor-status { display: flex; align-items: center; gap: 8rpx; margin-top: 16rpx; padding: 10rpx 16rpx; border-radius: 10rpx; font-size: 22rpx; font-weight: 700; }
.sensor-status.normal { background: var(--green-bg); color: var(--green); border: 1rpx solid rgba(34,197,94,0.08); }
.sensor-status.alert  { background: var(--red-bg);  color: var(--red);   border: 1rpx solid rgba(239,68,68,0.08); }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }
.sensor-status.normal .status-dot { background: var(--green); box-shadow: 0 0 6rpx rgba(34,197,94,0.4); }
.sensor-status.alert  .status-dot { background: var(--red);   box-shadow: 0 0 6rpx rgba(239,68,68,0.4); }

/* ══ 控制卡片 ══ */
.ctrl-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx; padding: 30rpx 34rpx;
  box-shadow: var(--bezel-strong);
  display: flex; justify-content: space-between; align-items: center;
}
.ctrl-value { font-size: 28rpx; font-weight: 800; color: var(--text-primary); }
/* WPT Monitor V5.1.3：首页样式。 */
