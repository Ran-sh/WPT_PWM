.page {
  min-height: 100vh;
  background: #030712;
  padding: 0 16px;
}

/* ── 状态栏 ── */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1rpx solid #1f2937;
  margin-bottom: 8px;
}
.title { font-size: 18px; font-weight: 600; color: #e5e7eb; }
.indicator { display: flex; align-items: center; gap: 6px; }
.dot { width: 8px; height: 8px; border-radius: 50%; }
.dot-green  { background: #4ade80; }
.dot-red    { background: #ef4444; }
.label { font-size: 12px; color: #9ca3af; }

/* ── 数据行 ── */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: #111827;
  border: 1rpx solid #1f2937;
  border-radius: 10px;
  margin-bottom: 8px;
}
.row-label {
  font-size: 14px;
  color: #9ca3af;
}
.row-value {
  font-size: 28px;
  font-weight: 700;
}
.row-value-row {
  display: flex;
  align-items: baseline;
  gap: 4px;
}
.row-unit {
  font-size: 14px;
  color: #6b7280;
}

.text-cyan   { color: #22d3ee; }
.text-green  { color: #4ade80; }
.text-yellow { color: #facc15; }
.text-red    { color: #ef4444; }
.text-gray   { color: #6b7280; }

/* ── 选取器行 ── */
.picker-row {
  padding: 4px 8px 4px 16px;
  gap: 0;
}
.freq-swiper {
  flex: 1;
  height: 80rpx;
}
.swipe-item {
  display: flex;
  align-items: center;
  justify-content: center;
}
.swipe-num {
  font-size: 18px;
  color: #9ca3af;
}
.swipe-sel {
  font-size: 30px;
  font-weight: 700;
  color: #22d3ee;
}
.btn-set {
  width: 100rpx;
  height: 56rpx;
  padding: 0;
  margin: 0;
  background: rgba(34,211,238,0.15);
  border: 1rpx solid rgba(34,211,238,0.4);
  border-radius: 8px;
  color: #22d3ee;
  font-size: 13px;
  font-weight: 600;
  line-height: 56rpx;
}
.btn-set[disabled] { opacity: 0.3; }

/* ── 启停按钮 ── */
.btn-power {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 700;
  line-height: 52px;
  margin-top: 8px;
}
.btn-start {
  background: rgba(239,68,68,0.15);
  border: 1rpx solid rgba(239,68,68,0.5);
  color: #f87171;
}
.btn-stop {
  background: rgba(34,197,94,0.15);
  border: 1rpx solid rgba(34,197,94,0.5);
  color: #4ade80;
}
.btn-power[disabled] { opacity: 0.4; }
